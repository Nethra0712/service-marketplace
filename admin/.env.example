# Copy to .env.local and adjust. Never commit a real .env.local file.

# The backend API's own base URL. Every request the admin app makes goes
# directly from the BROWSER to this origin (cookie-based session, sent
# cross-origin with credentials: 'include' — see lib/api-client.ts), so this
# must be a URL the browser itself can reach, not just the Next.js server.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
