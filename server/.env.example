# Copy to .env and adjust. Never commit a real .env file.

NODE_ENV=development
PORT=3000

# Runtime connection string. Replace CHANGE_ME with your local password.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/service_marketplace

# Used only by the test suite. The database name MUST end in "_test": the test
# runner applies migrations and truncates tables in it, and refuses to touch
# anything else.
DATABASE_URL_TEST=postgresql://postgres:CHANGE_ME@localhost:5432/service_marketplace_test

# Comma-separated list of allowed browser origins (e.g. the admin web app).
# Empty means no cross-origin browser access. The mobile app does not need CORS.
CORS_ORIGINS=

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Authentication ---------------------------------------------------------
# Two DIFFERENT random secrets, each at least 32 characters. Generate with:
#   openssl rand -base64 48
# The placeholders below pass validation in development but are rejected when
# NODE_ENV=production. Rotating JWT_ACCESS_SECRET signs everyone out of API
# access until they refresh; rotating OTP_HMAC_SECRET invalidates pending codes.
JWT_ACCESS_SECRET=replace-with-a-random-secret-from-openssl-rand-base64-48
OTP_HMAC_SECRET=replace-with-a-different-random-secret-from-openssl-rand-base64
# Signs the admin dashboard's session cookie. Independent from the two above.
ADMIN_JWT_SECRET=replace-with-yet-another-random-secret-from-openssl-rand-base64

# How OTPs are delivered. Only "mock" exists today: it sends nothing and prints
# the code in the server log. It is refused when NODE_ENV=production.
SMS_PROVIDER=mock

# Comma-separated calling codes (no "+") phone numbers may start with.
ALLOWED_PHONE_COUNTRY_CODES=94

# Reverse proxies in front of the API (0 = none). Needed for correct client IPs.
TRUST_PROXY_HOPS=0

# --- Payments ----------------------------------------------------------------
# Which gateway processes checkouts/refunds. Only "mock" moves no real money;
# it is refused when NODE_ENV=production.
PAYMENT_PROVIDER=mock

# Platform commission, in basis points (1500 = 15.00%). Read everywhere
# commission needs computing; never hardcode a rate in application code.
PLATFORM_COMMISSION_BASIS_POINTS=1500

# This API's own publicly reachable base URL, used to build PayHere's
# return/cancel/notify URLs. Required only when PAYMENT_PROVIDER=payhere.
PUBLIC_API_BASE_URL=

# PayHere merchant credentials (sandbox at https://sandbox.payhere.lk).
# Required only when PAYMENT_PROVIDER=payhere. Never commit real values.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_MODE=sandbox

# --- Notifications -------------------------------------------------------------
# Which backend delivers push notifications. Only "mock" exists today for
# real delivery testing here; it sends nothing and logs instead. It is
# refused when NODE_ENV=production.
PUSH_PROVIDER=mock

# Firebase Admin SDK service-account credentials (from the Firebase console:
# Project settings > Service accounts > Generate new private key). Required
# only when PUSH_PROVIDER=fcm. Never commit real values. FCM_PRIVATE_KEY keeps
# its newlines escaped as literal \n on one line, the way the downloaded JSON
# file has them.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
